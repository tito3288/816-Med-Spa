---
const dentalPracticeUrl = "https://cosmeticimplantdentistrywp.com/";
const dentalOfficeImage =
  "https://cosmeticimplantdentistrywp.com/wp-content/uploads/2025/12/CIDWPop3-scaled.jpg";
---

<section class="relative overflow-hidden bg-bone py-20 lg:py-28" aria-labelledby="dental-neighbor-title">
  <div
    class="pointer-events-none absolute -top-28 -right-24 size-80 rounded-full bg-sage/10 blur-3xl"
    aria-hidden="true"
  ></div>
  <div class="container relative mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16">
      <div class="relative" data-reveal="fade-right">
        <div
          class="absolute -bottom-3 -left-3 h-full w-full rounded-[1.75rem] border border-sage/30 sm:-bottom-4 sm:-left-4"
          aria-hidden="true"
        ></div>
        <div class="relative aspect-[4/3] overflow-hidden rounded-[1.75rem] bg-warmGray shadow-sm">
          <img
            src={dentalOfficeImage}
            alt="Treatment room at Cosmetic and Implant Dentistry Westport"
            class="size-full object-cover"
            loading="lazy"
            decoding="async"
            width="1920"
            height="1280"
          />
          <div
            class="pointer-events-none absolute inset-0 bg-gradient-to-t from-espresso/55 via-transparent to-transparent"
            aria-hidden="true"
          ></div>
          <div
            class="absolute right-5 bottom-5 left-5 flex items-center gap-3 rounded-full border border-white/25 bg-espresso/75 px-5 py-3 text-sm text-white shadow-sm backdrop-blur-sm sm:right-auto sm:max-w-max"
          >
            <svg
              class="size-5 shrink-0 text-cream"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              aria-hidden="true"
            >
              <path d="M12 21s7-5.1 7-12a7 7 0 1 0-14 0c0 6.9 7 12 7 12Z"></path>
              <circle cx="12" cy="9" r="2.25"></circle>
            </svg>
            <span>Also at 638 W 39th St.</span>
          </div>
        </div>
      </div>

      <div>
        <p
          class="mb-5 font-sans-wide text-[11px] font-medium tracking-[0.32em] uppercase text-gold"
          data-reveal
        >
          Our Dental Neighbors
        </p>
        <h2
          id="dental-neighbor-title"
          class="max-w-xl font-display text-4xl font-normal leading-[1.08] text-ink sm:text-5xl lg:text-6xl"
          data-reveal
          style="--reveal-delay: 100ms"
        >
          Your smile is part of the <span class="font-serif-italic italic text-gold">whole</span>
          picture.
        </h2>
        <p
          class="mt-7 max-w-xl text-lg leading-relaxed text-ink/70"
          data-reveal
          style="--reveal-delay: 180ms"
        >
          We share our Westport address with Cosmetic &amp; Implant Dentistry Westport, offering
          general, cosmetic, restorative, and implant dentistry. Different expertise, the same
          convenient Kansas City location.
        </p>

        <div
          class="mt-8 border-l-2 border-sage/35 pl-5"
          data-reveal
          style="--reveal-delay: 240ms"
        >
          <p class="font-display text-2xl italic text-ink">care for a healthier, confident smile.</p>
        </div>

        <a
          href={dentalPracticeUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-9 inline-flex items-center gap-3 rounded-full bg-sage px-7 py-3.5 font-sans-wide text-[11px] font-medium tracking-[0.22em] text-white uppercase transition hover:bg-espresso focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sage"
          data-reveal
          style="--reveal-delay: 300ms"
        >
          Visit the Dental Practice
          <svg
            class="size-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M7 17 17 7M8 7h9v9"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
