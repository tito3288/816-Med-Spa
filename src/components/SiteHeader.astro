---
import { categories, concernsByCategory } from "../data/concerns";
import { serviceMenu, getService } from "../data/services";
import { treatmentsByGroup } from "../data/treatments";

type NavChild = { href: string; label: string; external?: boolean };
type NavLink = {
  href: string;
  label: string;
  caret?: boolean;
  mega?: "concerns" | "treatments";
  children?: NavChild[];
};

const appointmentUrl = "https://816medspa.janeapp.com/";

const concernGroups = categories.map((category) => ({
  category,
  items: concernsByCategory(category),
}));

const serviceColumns = serviceMenu.map((column) => ({
  category: column.category,
  groups: column.groups.map((group) => ({
    label: group.label,
    items: group.services.map((slug) => getService(slug)).filter((s) => s !== undefined),
  })),
}));

const ageTreatments = treatmentsByGroup("By Age");

const navLinks: NavLink[] = [
  { href: "/", label: "Home" },
  {
    href: "/#about",
    label: "About",
    children: [
      { href: "/about-us/meet-the-doctor", label: "Meet the Doctor" },
      { href: "/about-us/meet-the-team", label: "Meet the Team" },
    ],
  },
  { href: "/treatments", label: "Treatments", mega: "treatments" },
  { href: "/memberships", label: "Memberships" },
  { href: "/concerns", label: "Concerns", mega: "concerns" },
  { href: "/gallery", label: "Gallery" },
  {
    href: "/contact-us",
    label: "Contact",
    children: [
      {
        href: appointmentUrl,
        label: "Book Appointment",
        external: true,
      },
    ],
  },
];
---

<header
  class="fixed inset-x-0 top-0 z-50 border-b border-transparent bg-transparent text-parchment transition-colors duration-300"
  data-site-header
>
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Mobile / tablet: single row -->
    <div class="flex items-center justify-between py-4 md:py-5 min-[1024px]:hidden">
      <a href="/" class="shrink-0" aria-label="816 Med Spa home">
        <img
          src="/logo.png"
          alt="816 Med Spa"
          class="h-24 w-auto transition-all duration-300 sm:h-28"
          data-mobile-header-logo
        />
      </a>
      <div class="flex items-center gap-3">
        <a
          href={appointmentUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="hidden rounded-full border border-parchment/70 bg-transparent px-4 py-2.5 font-sans-wide text-[11px] font-medium tracking-[0.35em] text-parchment uppercase transition hover:bg-parchment hover:text-ink sm:inline-block"
          data-header-cta
        >
          Book Appointment
        </a>
        <button
          type="button"
          class="p-2 text-current transition hover:text-sage"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
          data-mobile-menu-button
        >
          <svg
            class="h-6 w-6"
            data-icon="open"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <svg
            class="hidden h-6 w-6"
            data-icon="close"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 6l12 12M6 18L18 6"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Desktop: centered logo + nav row -->
    <div
      class="hidden py-6 transition-[padding] duration-300 min-[1024px]:block"
      data-desktop-header-inner
    >
      <div class="grid grid-cols-[1fr_auto_1fr] items-center">
        <div aria-hidden="true"></div>
        <a
          href="/"
          class="flex flex-col items-center justify-self-center"
          aria-label="816 Med Spa home"
        >
          <img
            src="/logo.png"
            alt="816 Med Spa"
            class="h-[110px] w-auto drop-shadow-[0_2px_14px_rgba(0,0,0,0.35)] transition-all duration-300"
            data-header-logo
          />
          <span
            class="mt-2 overflow-hidden font-sans-wide text-[10px] tracking-[0.55em] text-parchment uppercase opacity-100 transition-all duration-300"
            data-header-subtitle
          >
            Med Spa &middot; Kansas City
          </span>
        </a>
        <div class="flex items-center justify-end gap-[18px] justify-self-end">
          <a
            href={appointmentUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-full border border-parchment/70 bg-transparent px-6 py-[14px] font-sans-wide text-[11px] font-medium tracking-[0.35em] text-parchment uppercase transition hover:bg-parchment hover:text-ink"
            data-header-cta
          >
            Book Appointment
          </a>
        </div>
      </div>
      <nav
        class="mt-6 flex flex-wrap items-center justify-center gap-x-3 gap-y-2 transition-[margin] duration-300 min-[1000px]:gap-x-5 min-[1100px]:gap-x-9 xl:gap-x-12"
        aria-label="Primary"
        data-header-nav
      >
        {navLinks.map((link) =>
          link.mega ? (
            <div class="group relative">
              <a
                href={link.href}
                class="inline-flex items-center font-sans-wide text-[11px] font-medium tracking-[0.35em] text-current uppercase transition hover:text-sage focus-visible:text-sage"
                data-header-nav-link
                aria-haspopup="true"
              >
                {link.label}
                <span aria-hidden="true" class="ml-1 text-[9px] opacity-80">▾</span>
              </a>
              <div
                class="invisible absolute top-full left-1/2 z-50 -translate-x-1/2 pt-3 opacity-0 transition-all duration-150 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100"
              >
                <div
                  class="w-[min(1040px,92vw)] rounded-2xl border border-sage/15 bg-white p-8 shadow-lg"
                  role={link.mega === "concerns" ? "menu" : undefined}
                >
                  {link.mega === "treatments" ? (
                    <div
                      class="grid min-h-[380px] grid-cols-[180px_minmax(0,1fr)_190px] gap-x-7"
                      data-treatment-mega
                    >
                      <div class="border-r border-sage/15 pr-6" role="tablist" aria-label="Treatment categories">
                        <p class="mb-4 font-sans-wide text-[9px] font-semibold tracking-[0.24em] text-ink/40 uppercase">
                          Explore
                        </p>
                        <div class="space-y-1.5">
                          {serviceColumns.map((column, i) => (
                            <button
                              type="button"
                              class="group/tab flex w-full items-center justify-between rounded-lg px-3 py-3 text-left font-display text-xl font-semibold text-ink transition hover:bg-sage/8 hover:text-sage data-[active=true]:bg-sage/10 data-[active=true]:text-sage focus-visible:bg-sage/10 focus-visible:text-sage focus-visible:outline-none"
                              role="tab"
                              aria-selected={i === 0 ? "true" : "false"}
                              aria-controls={`treatment-panel-${column.category.toLowerCase()}`}
                              data-treatment-tab={String(i)}
                              data-active={i === 0 ? "true" : "false"}
                            >
                              {column.category}
                              <svg
                                class="size-4 opacity-40 transition group-hover/tab:translate-x-0.5 group-hover/tab:opacity-80"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.75"
                                aria-hidden="true"
                              >
                                <path stroke-linecap="round" stroke-linejoin="round" d="m9 18 6-6-6-6"></path>
                              </svg>
                            </button>
                          ))}
                        </div>
                      </div>

                      <div class="min-w-0" data-treatment-panels>
                        {serviceColumns.map((column, i) => (
                          <div
                            id={`treatment-panel-${column.category.toLowerCase()}`}
                            class={i === 0 ? "" : "hidden"}
                            role="tabpanel"
                            data-treatment-panel={String(i)}
                          >
                            <div class="flex items-center justify-between border-b border-sage/15 pb-3">
                              <p class="font-sans-wide text-[11px] font-semibold tracking-[0.28em] text-gold uppercase">
                                {column.category} Treatments
                              </p>
                              <a
                                href={`/treatments/${column.category.toLowerCase()}`}
                                class="inline-flex items-center gap-1.5 text-[11px] font-medium text-sage transition hover:text-ink"
                              >
                                View all
                                <span aria-hidden="true">→</span>
                              </a>
                            </div>
                            <div class="mt-4 grid grid-cols-2 gap-x-6 gap-y-4">
                              {column.groups.map((group) => (
                                <div class={group.items.length > 6 ? "col-span-2" : ""}>
                                  <p class="px-2 font-sans-wide text-[9px] font-semibold tracking-[0.24em] text-ink/45 uppercase">
                                    {group.label}
                                  </p>
                                  <ul class={group.items.length > 6 ? "mt-1.5 grid grid-cols-2 gap-x-4" : "mt-1.5 space-y-0.5"}>
                                    {group.items.map((item) => (
                                      <li>
                                        <a
                                          href={`/services/${item.slug}`}
                                          role="menuitem"
                                          class="block rounded-md px-2 py-1.5 font-sans-wide text-[11px] tracking-[0.04em] text-gray-700 transition hover:bg-sage/5 hover:text-sage focus-visible:bg-sage/5 focus-visible:text-sage focus-visible:outline-none"
                                        >
                                          {item.name}
                                        </a>
                                      </li>
                                    ))}
                                  </ul>
                                </div>
                              ))}
                            </div>
                          </div>
                        ))}
                      </div>

                      <div class="border-l border-sage/15 pl-7">
                        <a
                          href="/treatments#by-age"
                          class="block border-b border-sage/15 pb-3 font-sans-wide text-[11px] font-semibold tracking-[0.28em] text-gold uppercase transition hover:text-sage"
                        >
                          By Age
                        </a>
                        <ul class="mt-4 space-y-1">
                          {ageTreatments.map((item) => (
                            <li>
                              <a
                                href={`/treatments/${item.slug}`}
                                role="menuitem"
                                class="block rounded-md px-2 py-2 font-sans-wide text-[11px] tracking-[0.04em] text-gray-700 transition hover:bg-sage/5 hover:text-sage focus-visible:bg-sage/5 focus-visible:text-sage focus-visible:outline-none"
                              >
                                {item.name}
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    </div>
                  ) : (
                    <div class="grid grid-cols-4 gap-x-8 gap-y-2">
                      {concernGroups.map((group) => (
                        <div>
                          <a
                            href="/concerns"
                            class="block border-b border-sage/15 pb-3 font-sans-wide text-[11px] font-semibold tracking-[0.28em] text-gold uppercase transition hover:text-sage"
                          >
                            {group.category}
                          </a>
                          <ul class="mt-3 space-y-1">
                            {group.items.map((item) => (
                              <li>
                                <a
                                  href={`/concerns/${item.slug}`}
                                  role="menuitem"
                                  class="block rounded-md px-2 py-1.5 font-sans-wide text-[11px] tracking-[0.04em] text-gray-700 transition hover:bg-sage/5 hover:text-sage focus-visible:bg-sage/5 focus-visible:text-sage focus-visible:outline-none"
                                >
                                  {item.name}
                                </a>
                              </li>
                            ))}
                          </ul>
                        </div>
                      ))}
                    </div>
                  )}
                </div>
              </div>
            </div>
          ) : link.children ? (
            <div class="group relative">
              <a
                href={link.href}
                class="inline-flex items-center font-sans-wide text-[11px] font-medium tracking-[0.35em] text-current uppercase transition hover:text-sage focus-visible:text-sage"
                data-header-nav-link
                aria-haspopup="true"
              >
                {link.label}
                <span aria-hidden="true" class="ml-1 text-[9px] opacity-80">▾</span>
              </a>
              <div
                class="invisible absolute top-full left-1/2 z-50 -translate-x-1/2 pt-3 opacity-0 transition-all duration-150 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100"
              >
                <div
                  class="min-w-[240px] rounded-2xl border border-sage/15 bg-white py-2 shadow-lg"
                  role="menu"
                >
                  {link.children.map((child) => (
                    <a
                      href={child.href}
                      target={child.external ? "_blank" : undefined}
                      rel={child.external ? "noopener noreferrer" : undefined}
                      role="menuitem"
                      class="block px-5 py-3 font-sans-wide text-[10px] font-medium tracking-[0.28em] whitespace-nowrap text-gray-700 uppercase transition hover:bg-sage/5 hover:text-sage focus-visible:bg-sage/5 focus-visible:text-sage focus-visible:outline-none"
                    >
                      {child.label}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          ) : (
            <a
              href={link.href}
              class="inline-flex items-center font-sans-wide text-[11px] font-medium tracking-[0.35em] text-current uppercase transition hover:text-sage focus-visible:text-sage"
              data-header-nav-link
            >
              {link.label}
              {link.caret && (
                <span aria-hidden="true" class="ml-1 text-[9px] opacity-80">▾</span>
              )}
            </a>
          ),
        )}
      </nav>
    </div>

    <div id="mobile-menu" class="hidden pb-4 min-[1024px]:hidden" data-mobile-menu>
      <nav class="flex flex-col gap-1 border-t border-current/20 pt-4" aria-label="Mobile">
        {navLinks.map((link, i) => {
          if (link.mega) {
            const megaId = `mobile-nav-submenu-${i}`;
            return (
              <div>
                <div class="flex items-center justify-between">
                  <a
                    href={link.href}
                    class="flex-1 px-2 py-3 text-base font-medium text-current transition hover:text-sage focus-visible:text-sage"
                  >
                    {link.label}
                  </a>
                  <button
                    type="button"
                    class="p-3 text-current transition hover:text-sage focus-visible:text-sage focus-visible:outline-none"
                    aria-expanded="false"
                    aria-controls={megaId}
                    aria-label={`Toggle ${link.label} submenu`}
                    data-mobile-nav-toggle
                  >
                    <svg
                      class="h-4 w-4 transition-transform duration-200"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                      data-mobile-nav-chevron
                    >
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                    </svg>
                  </button>
                </div>
                <div id={megaId} class="hidden" data-mobile-nav-submenu>
                  {(link.mega === "treatments" ? serviceColumns : concernGroups).map(
                    (entry: any, gi: number) => {
                    const groupId = `mobile-nav-submenu-${i}-${gi}`;
                    const isTreatments = link.mega === "treatments";
                    const indexHref =
                      link.mega === "treatments"
                        ? `/treatments/${entry.category.toLowerCase()}`
                        : "/concerns";
                    const itemBase = link.mega === "treatments" ? "/services" : "/concerns";
                    return (
                      <div class="ml-4">
                        <div class="flex items-center justify-between">
                          <a
                            href={indexHref}
                            class="flex-1 px-2 py-2 font-sans-wide text-xs font-semibold tracking-[0.2em] text-current uppercase transition hover:text-sage focus-visible:text-sage"
                          >
                            {entry.category}
                          </a>
                          <button
                            type="button"
                            class="p-3 text-current transition hover:text-sage focus-visible:text-sage focus-visible:outline-none"
                            aria-expanded="false"
                            aria-controls={groupId}
                            aria-label={`Toggle ${entry.category} ${link.mega}`}
                            data-mobile-nav-toggle
                          >
                            <svg
                              class="h-4 w-4 transition-transform duration-200"
                              fill="none"
                              stroke="currentColor"
                              viewBox="0 0 24 24"
                              aria-hidden="true"
                              data-mobile-nav-chevron
                            >
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                            </svg>
                          </button>
                        </div>
                        <div id={groupId} class="hidden" data-mobile-nav-submenu>
                          {isTreatments
                            ? entry.groups.map((group: any) => (
                                <div class="mt-1">
                                  <p class="ml-4 px-2 pt-2 font-sans-wide text-[10px] font-semibold tracking-[0.2em] text-current/45 uppercase">
                                    {group.label}
                                  </p>
                                  {group.items.map((item: any) => (
                                    <a
                                      href={`/services/${item.slug}`}
                                      class="block ml-4 px-2 py-2 text-sm font-medium text-current/80 transition hover:text-sage focus-visible:text-sage"
                                    >
                                      {item.name}
                                    </a>
                                  ))}
                                </div>
                              ))
                            : entry.items.map((item: any) => (
                                <a
                                  href={`${itemBase}/${item.slug}`}
                                  class="block ml-4 px-2 py-2 text-sm font-medium text-current/80 transition hover:text-sage focus-visible:text-sage"
                                >
                                  {item.name}
                                </a>
                              ))}
                        </div>
                      </div>
                    );
                    }
                  )}
                  {link.mega === "treatments" && (
                    <div class="mt-2 ml-4 border-t border-current/15 pt-2">
                      <div class="flex items-center justify-between">
                        <a
                          href="/treatments#by-age"
                          class="flex-1 px-2 py-2 font-sans-wide text-xs font-semibold tracking-[0.2em] text-current uppercase transition hover:text-sage focus-visible:text-sage"
                        >
                          By Age
                        </a>
                        <button
                          type="button"
                          class="p-3 text-current transition hover:text-sage focus-visible:text-sage focus-visible:outline-none"
                          aria-expanded="false"
                          aria-controls={`${megaId}-by-age`}
                          aria-label="Toggle treatments by age"
                          data-mobile-nav-toggle
                        >
                          <svg
                            class="h-4 w-4 transition-transform duration-200"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            aria-hidden="true"
                            data-mobile-nav-chevron
                          >
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                          </svg>
                        </button>
                      </div>
                      <div id={`${megaId}-by-age`} class="hidden" data-mobile-nav-submenu>
                        {ageTreatments.map((item) => (
                          <a
                            href={`/treatments/${item.slug}`}
                            class="block ml-4 px-2 py-2 text-sm font-medium text-current/80 transition hover:text-sage focus-visible:text-sage"
                          >
                            {item.name}
                          </a>
                        ))}
                      </div>
                    </div>
                  )}
                </div>
              </div>
            );
          }
          if (link.children) {
            const submenuId = `mobile-nav-submenu-${i}`;
            return (
              <div>
                <div class="flex items-center justify-between">
                  <a
                    href={link.href}
                    class="flex-1 px-2 py-3 text-base font-medium text-current transition hover:text-sage focus-visible:text-sage"
                  >
                    {link.label}
                  </a>
                  <button
                    type="button"
                    class="p-3 text-current transition hover:text-sage focus-visible:text-sage focus-visible:outline-none"
                    aria-expanded="false"
                    aria-controls={submenuId}
                    aria-label={`Toggle ${link.label} submenu`}
                    data-mobile-nav-toggle
                  >
                    <svg
                      class="h-4 w-4 transition-transform duration-200"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                      data-mobile-nav-chevron
                    >
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                    </svg>
                  </button>
                </div>
                <div id={submenuId} class="hidden" data-mobile-nav-submenu>
                  {link.children.map((child) => (
                    <a
                      href={child.href}
                      target={child.external ? "_blank" : undefined}
                      rel={child.external ? "noopener noreferrer" : undefined}
                      class="block ml-4 px-2 py-2 text-sm font-medium text-current/80 transition hover:text-sage focus-visible:text-sage"
                    >
                      {child.label}
                    </a>
                  ))}
                </div>
              </div>
            );
          }
          return (
            <a
              href={link.href}
              class="px-2 py-3 text-base font-medium text-current transition hover:text-sage focus-visible:text-sage"
            >
              {link.label}
            </a>
          );
        })}
        <a
          href={appointmentUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-3 rounded-full border border-parchment/70 bg-transparent px-6 py-3 text-center font-medium text-parchment transition hover:bg-parchment hover:text-ink"
          data-header-cta
        >
          Book Appointment
        </a>
      </nav>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-site-header]");
  const headerCtas = document.querySelectorAll<HTMLElement>("[data-header-cta]");
  const headerNavLinks = document.querySelectorAll<HTMLElement>("[data-header-nav-link]");
  const headerLogo = document.querySelector<HTMLElement>("[data-header-logo]");
  const mobileHeaderLogo = document.querySelector<HTMLElement>("[data-mobile-header-logo]");
  const headerSubtitle = document.querySelector<HTMLElement>("[data-header-subtitle]");
  const desktopHeaderInner = document.querySelector<HTMLElement>("[data-desktop-header-inner]");
  const headerNav = document.querySelector<HTMLElement>("[data-header-nav]");
  const button = document.querySelector<HTMLButtonElement>("[data-mobile-menu-button]");
  const menu = document.querySelector<HTMLElement>("[data-mobile-menu]");
  const navToggles = document.querySelectorAll<HTMLButtonElement>("[data-mobile-nav-toggle]");

  const setSubmenuOpen = (toggle: HTMLButtonElement, open: boolean) => {
    toggle.setAttribute("aria-expanded", String(open));
    const id = toggle.getAttribute("aria-controls");
    const submenu = id ? document.getElementById(id) : null;
    submenu?.classList.toggle("hidden", !open);
    const chevron = toggle.querySelector<SVGElement>("[data-mobile-nav-chevron]");
    chevron?.classList.toggle("rotate-180", open);
  };

  navToggles.forEach((toggle) => {
    toggle.addEventListener("click", () => {
      const expanded = toggle.getAttribute("aria-expanded") === "true";
      setSubmenuOpen(toggle, !expanded);
    });
  });

  document.querySelectorAll<HTMLElement>("[data-treatment-mega]").forEach((mega) => {
    const tabs = [...mega.querySelectorAll<HTMLButtonElement>("[data-treatment-tab]")];
    const panels = [...mega.querySelectorAll<HTMLElement>("[data-treatment-panel]")];

    const selectTreatmentCategory = (index: number) => {
      tabs.forEach((tab, tabIndex) => {
        const active = tabIndex === index;
        tab.dataset.active = String(active);
        tab.setAttribute("aria-selected", String(active));
      });
      panels.forEach((panel, panelIndex) => {
        panel.classList.toggle("hidden", panelIndex !== index);
      });
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener("mouseenter", () => selectTreatmentCategory(index));
      tab.addEventListener("focus", () => selectTreatmentCategory(index));
      tab.addEventListener("click", () => selectTreatmentCategory(index));
    });
  });

  const setHeaderAtTop = () => {
    if (!header) return;

    const menuOpen = menu ? !menu.classList.contains("hidden") : false;
    const atTop = window.scrollY < 12 && !menuOpen;

    header.classList.toggle("border-transparent", atTop);
    header.classList.toggle("bg-transparent", atTop);
    header.classList.toggle("text-parchment", atTop);
    header.classList.toggle("border-sage/20", !atTop);
    header.classList.toggle("bg-white", !atTop);
    header.classList.toggle("text-gray-900", !atTop);
    header.classList.toggle("shadow-sm", !atTop);

    desktopHeaderInner?.classList.toggle("py-6", atTop);
    desktopHeaderInner?.classList.toggle("py-4", !atTop);
    headerLogo?.classList.toggle("h-[110px]", atTop);
    headerLogo?.classList.toggle("h-14", !atTop);
    headerLogo?.classList.toggle("xl:h-16", !atTop);

    mobileHeaderLogo?.classList.toggle("h-24", atTop);
    mobileHeaderLogo?.classList.toggle("sm:h-28", atTop);
    mobileHeaderLogo?.classList.toggle("h-12", !atTop);
    mobileHeaderLogo?.classList.toggle("sm:h-14", !atTop);
    headerNav?.classList.toggle("mt-6", atTop);
    headerNav?.classList.toggle("mt-3", !atTop);

    headerSubtitle?.classList.toggle("opacity-100", atTop);
    headerSubtitle?.classList.toggle("mt-2", atTop);
    headerSubtitle?.classList.toggle("opacity-0", !atTop);
    headerSubtitle?.classList.toggle("mt-0", !atTop);
    headerSubtitle?.classList.toggle("h-0", !atTop);

    headerNavLinks.forEach((link) => {
      link.classList.toggle("text-[11px]", atTop);
      link.classList.toggle("tracking-[0.35em]", atTop);
      link.classList.toggle("text-[10px]", !atTop);
      link.classList.toggle("tracking-[0.28em]", !atTop);
    });

    headerCtas.forEach((cta) => {
      cta.classList.toggle("border-parchment/70", atTop);
      cta.classList.toggle("bg-transparent", atTop);
      cta.classList.toggle("text-parchment", atTop);
      cta.classList.toggle("hover:bg-parchment", atTop);
      cta.classList.toggle("hover:text-ink", atTop);
      cta.classList.toggle("border-sage", !atTop);
      cta.classList.toggle("bg-sage", !atTop);
      cta.classList.toggle("text-white", !atTop);
      cta.classList.toggle("hover:bg-sage/90", !atTop);
    });
  };

  setHeaderAtTop();
  window.addEventListener("scroll", setHeaderAtTop, { passive: true });

  if (button && menu) {
    const openIcon = button.querySelector<SVGElement>('[data-icon="open"]');
    const closeIcon = button.querySelector<SVGElement>('[data-icon="close"]');

    const setOpen = (open: boolean) => {
      menu.classList.toggle("hidden", !open);
      button.setAttribute("aria-expanded", String(open));
      button.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      openIcon?.classList.toggle("hidden", open);
      closeIcon?.classList.toggle("hidden", !open);
      setHeaderAtTop();
      if (!open) {
        navToggles.forEach((toggle) => setSubmenuOpen(toggle, false));
      }
    };

    button.addEventListener("click", () => {
      setOpen(menu.classList.contains("hidden"));
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !menu.classList.contains("hidden")) {
        setOpen(false);
        button.focus();
      }
    });

    menu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });
  }
</script>
