---
---

<section class="hero relative isolate min-h-screen w-full overflow-hidden">
  <div
    class="relative z-[1] flex min-h-screen flex-col items-center justify-center px-6 pt-[200px] pb-[120px] text-center max-[900px]:pt-[160px]"
  >
    <p class="hero-eyebrow" data-reveal>Med Spa in Kansas City, Missouri</p>
    <h1 class="hero-headline" data-reveal style="--reveal-delay: 120ms">
      this must be<br />the place.
    </h1>
    <div
      class="hero-ctas flex flex-wrap justify-center gap-[22px]"
      data-reveal
      style="--reveal-delay: 320ms"
    >
      <a href="/contact-us" class="hero-btn">Contact Us</a>
      <a
        href="https://816medspa.janeapp.com/online_gift_cards/new"
        class="hero-btn"
        target="_blank"
        rel="noopener noreferrer"
      >
        Gift Cards
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    background-color: #8f7f68;
    background-image:
      linear-gradient(rgba(32, 28, 24, 0.48), rgba(32, 28, 24, 0.58)),
      url("/images/branding/home-lobby-hero.jpg");
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  @media (max-width: 640px) {
    .hero {
      background-image:
        linear-gradient(rgba(32, 28, 24, 0.5), rgba(32, 28, 24, 0.62)),
        url("/images/branding/home-lobby-hero-mobile.jpg");
    }
  }

  .hero-eyebrow {
    font-family: var(--font-sans-wide);
    font-weight: 400;
    font-size: 11px;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--color-parchment);
    opacity: 0.95;
    margin-bottom: 28px;
  }

  .hero-headline {
    font-family: var(--font-serif-italic);
    font-weight: 300;
    font-style: italic;
    font-size: clamp(56px, 8vw, 132px);
    line-height: 1;
    letter-spacing: -0.01em;
    color: var(--color-parchment);
    max-width: 1000px;
    margin: 0 0 56px;
  }

  .hero-btn {
    display: inline-block;
    padding: 20px 36px;
    border: 1px solid var(--color-parchment);
    border-radius: 9999px;
    color: var(--color-parchment);
    background: transparent;
    font-family: var(--font-sans-wide);
    font-weight: 400;
    font-size: 11px;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    text-align: center;
    min-width: 220px;
    transition: all 0.25s ease;
  }

  .hero-btn:hover {
    background: var(--color-parchment);
    color: var(--color-ink);
  }
</style>
