---
const year = new Date().getFullYear();

const links = [
  { href: "/", label: "Home" },
  { href: "/treatments", label: "Treatments" },
  { href: "/memberships", label: "Memberships" },
  { href: "/#about", label: "About Us" },
  { href: "/contact-us", label: "Request an Appointment" },
  { href: "/contact-us", label: "Contact Us" },
];
---

<footer class="border-t border-sage/20 bg-white py-12">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col items-center justify-between gap-8 lg:flex-row">
      <a href="/" aria-label="816 Med Spa home">
        <img src="/logo.png" alt="816 Med Spa" class="h-12 w-auto" />
      </a>
      <nav class="flex flex-wrap justify-center gap-6 text-sm text-gray-600" aria-label="Footer">
        {links.map((link) => (
          <a href={link.href} class="transition hover:text-sage">{link.label}</a>
        ))}
      </nav>
      <div class="flex items-center gap-3" role="group" aria-label="Social media">
        <a
          href="https://www.facebook.com/p/816-Aesthetic-Medical-Spa-61564981695970/"
          target="_blank"
          rel="noopener noreferrer"
          class="grid size-10 place-items-center rounded-full border border-sage/25 bg-bone text-sage transition hover:border-sage hover:bg-sage hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sage"
          aria-label="Visit 816 Aesthetic Medical Spa on Facebook"
        >
          <svg class="size-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M16 8.049C16 3.603 12.418 0 8 0S0 3.603 0 8.049C0 12.067 2.925 15.397 6.75 16v-5.624H4.719V8.049H6.75V6.276c0-2.017 1.194-3.131 3.022-3.131.875 0 1.791.157 1.791.157v1.984h-1.009c-.994 0-1.304.621-1.304 1.258v1.505h2.219l-.355 2.327H9.25V16C13.075 15.397 16 12.067 16 8.049Z"></path>
          </svg>
        </a>
        <a
          href="https://www.instagram.com/816aestheticmedspa/"
          target="_blank"
          rel="noopener noreferrer"
          class="grid size-10 place-items-center rounded-full border border-sage/25 bg-bone text-sage transition hover:border-sage hover:bg-sage hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sage"
          aria-label="Visit 816 Aesthetic Medical Spa on Instagram"
        >
          <svg
            class="size-[18px]"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.9"
            aria-hidden="true"
          >
            <rect x="3" y="3" width="18" height="18" rx="5"></rect>
            <circle cx="12" cy="12" r="4"></circle>
            <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle>
          </svg>
        </a>
      </div>
    </div>
    <p class="mt-8 border-t border-sage/15 pt-6 text-center text-sm text-gray-600">
      &copy; {year} 816 Aesthetic Med Spa. All rights reserved.
    </p>
  </div>
</footer>
