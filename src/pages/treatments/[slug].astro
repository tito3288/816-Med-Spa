---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import QuizTab from "../../components/QuizTab.astro";
import WhyChoose816 from "../../components/WhyChoose816.astro";
import {
  treatments,
  treatmentsByGroup,
  resolveConcerns,
  resolveServices,
} from "../../data/treatments";
import { processByCategory } from "../../data/process";

export function getStaticPaths() {
  return treatments.map((treatment) => ({
    params: { slug: treatment.slug },
    props: { treatment },
  }));
}

const { treatment } = Astro.props;
const janeAppUrl = "https://816medspa.janeapp.com/";

const concernItems = resolveConcerns(treatment.concernSlugs);
const serviceItems = resolveServices(treatment.serviceSlugs);
const steps = processByCategory["Treatments"] ?? [];

const related = treatmentsByGroup(treatment.group)
  .filter((t) => t.slug !== treatment.slug)
  .slice(0, 4);

// Build the alternating-background rhythm from the sections actually present.
const sectionOrder = [
  "understanding",
  "concerns",
  "services",
  ...(steps.length ? ["expect"] : []),
  "why",
  ...(treatment.faqs.length ? ["faq"] : []),
  ...(related.length ? ["related"] : []),
];
const bgOf = (key: string) =>
  sectionOrder.indexOf(key) % 2 === 0 ? "bg-bone" : "bg-cream";
---

<BaseLayout
  title={`${treatment.name} | Treatments | 816 Med Spa`}
  description={treatment.intro}
  canonical={`https://816medspa.com/treatments/${treatment.slug}/`}
  ogImage={treatment.image}
>
  <SiteHeader />
  <main>
    <section class="relative isolate overflow-hidden bg-espresso text-parchment">
      <div class="container mx-auto grid items-center gap-12 px-4 pt-[180px] pb-20 sm:px-6 lg:grid-cols-[1fr_0.82fr] lg:px-8 lg:pt-[230px] lg:pb-24">
        <div class="relative z-[1] max-w-3xl">
          <p
            class="mb-7 font-sans-wide text-[11px] font-normal tracking-[0.4em] uppercase text-parchment/80"
            data-reveal
          >
            Treatments &middot; {treatment.group}
          </p>
          <h1
            class="font-serif-italic text-[clamp(48px,7vw,104px)] font-light italic leading-[0.98] text-parchment"
            data-reveal
            style="--reveal-delay: 120ms"
          >
            {treatment.name}
          </h1>
          <p
            class="mt-8 max-w-2xl text-base leading-relaxed text-parchment/85 sm:text-lg"
            data-reveal
            style="--reveal-delay: 220ms"
          >
            {treatment.intro}
          </p>
        </div>

        <div
          class="relative z-[1] mx-auto w-full max-w-[480px]"
          data-reveal="fade-left"
          style="--reveal-delay: 260ms"
        >
          <div class="absolute top-4 left-4 h-full w-full rounded-lg bg-sage/50" aria-hidden="true"></div>
          <div class="relative aspect-[4/5] overflow-hidden rounded-lg bg-sage/20">
            <img
              src={treatment.image}
              alt={treatment.name}
              width="600"
              height="750"
              class="h-full w-full object-cover"
              loading="eager"
              decoding="async"
            />
          </div>
        </div>
      </div>
    </section>

    {/* Understanding */}
    <section class={`${bgOf("understanding")} py-20 lg:py-28`}>
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mx-auto grid max-w-6xl gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
          <div>
            <p
              class="mb-4 font-sans-wide text-[11px] font-medium tracking-[0.32em] uppercase text-gold"
              data-reveal
            >
              {treatment.group === "By Area" ? `Caring for ${treatment.name}` : `Life ${treatment.name}`}
            </p>
            <h2
              class="font-display text-5xl italic leading-[1.05] text-ink sm:text-6xl"
              data-reveal
              style="--reveal-delay: 120ms"
            >
              care made for you.
            </h2>
          </div>

          <div class="space-y-6 text-base leading-relaxed text-ink/70 sm:text-lg">
            {treatment.description.map((paragraph, p) => (
              <p data-reveal style={`--reveal-delay: ${180 + p * 60}ms`}>{paragraph}</p>
            ))}
          </div>
        </div>
      </div>
    </section>

    {/* Common concerns */}
    <section class={`${bgOf("concerns")} py-20 lg:py-28`}>
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-6xl">
          <div class="max-w-2xl">
            <p
              class="mb-4 font-sans-wide text-[11px] font-medium tracking-[0.32em] uppercase text-gold"
              data-reveal
            >
              Common Concerns
            </p>
            <h2
              class="font-display text-4xl italic leading-tight text-ink sm:text-5xl"
              data-reveal
              style="--reveal-delay: 120ms"
            >
              what we see most.
            </h2>
            <p
              class="mt-6 text-base leading-relaxed text-ink/70 sm:text-lg"
              data-reveal
              style="--reveal-delay: 180ms"
            >
              Each of these links to a deeper look at the concern — what causes it, how it shows up, and the treatments that help.
            </p>
          </div>

          <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {concernItems.map((item, i) => (
              <a
                href={`/concerns/${item.slug}`}
                class="group relative block aspect-[3/4] overflow-hidden rounded-lg shadow-sm transition hover:shadow-md focus-visible:ring-2 focus-visible:ring-sage focus-visible:ring-offset-2 focus-visible:ring-offset-cream"
                data-reveal
                style={`--reveal-delay: ${Math.min(i, 6) * 70}ms`}
              >
                <img
                  src={item.image}
                  alt={item.name}
                  class="absolute inset-0 size-full object-cover transition duration-500 group-hover:scale-105"
                  loading="lazy"
                  decoding="async"
                />
                <div
                  class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/80 via-black/25 to-transparent"
                  aria-hidden="true"
                ></div>
                <div class="relative flex h-full flex-col justify-end p-6">
                  <h3 class="font-display text-2xl text-white not-italic md:text-3xl">{item.name}</h3>
                  <p class="mt-2 text-sm leading-relaxed text-white/90">{item.intro}</p>
                </div>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    {/* Recommended treatments */}
    <section class={`${bgOf("services")} py-20 lg:py-28`}>
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-6xl">
          <div class="max-w-2xl">
            <p
              class="mb-4 font-sans-wide text-[11px] font-medium tracking-[0.32em] uppercase text-gold"
              data-reveal
            >
              Treatments We Recommend
            </p>
            <h2
              class="font-display text-4xl italic leading-tight text-ink sm:text-5xl"
              data-reveal
              style="--reveal-delay: 120ms"
            >
              our go-to treatments.
            </h2>
            <p
              class="mt-6 text-base leading-relaxed text-ink/70 sm:text-lg"
              data-reveal
              style="--reveal-delay: 180ms"
            >
              During your consultation, we'll recommend the right combination of these treatments for your skin, body, and goals.
            </p>
          </div>

          <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {serviceItems.map((item, i) => (
              <a
                href={`/services/${item.slug}`}
                class="group relative block aspect-[3/4] overflow-hidden rounded-lg shadow-sm transition hover:shadow-md focus-visible:ring-2 focus-visible:ring-sage focus-visible:ring-offset-2 focus-visible:ring-offset-cream"
                data-reveal
                style={`--reveal-delay: ${Math.min(i, 6) * 70}ms`}
              >
                <img
                  src={item.image}
                  alt={item.name}
                  class="absolute inset-0 size-full object-cover transition duration-500 group-hover:scale-105"
                  loading="lazy"
                  decoding="async"
                />
                <div
                  class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/80 via-black/25 to-transparent"
                  aria-hidden="true"
                ></div>
                <div class="relative flex h-full flex-col justify-end p-6">
                  <p class="font-sans-wide text-[10px] font-medium tracking-[0.28em] uppercase text-white/70">
                    {item.subgroup}
                  </p>
                  <h3 class="mt-2 font-display text-2xl text-white not-italic md:text-3xl">{item.name}</h3>
                  <p class="mt-2 text-sm leading-relaxed text-white/90">{item.intro}</p>
                </div>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    {/* What to expect */}
    {steps.length > 0 && (
      <section class={`${bgOf("expect")} py-20 lg:py-28`}>
        <div class="container mx-auto px-4 sm:px-6 lg:px-8">
          <div class="mx-auto max-w-6xl">
            <div class="max-w-2xl">
              <p
                class="mb-4 font-sans-wide text-[11px] font-medium tracking-[0.32em] uppercase text-gold"
                data-reveal
              >
                What to Expect
              </p>
              <h2
                class="font-display text-4xl italic leading-tight text-ink sm:text-5xl"
                data-reveal
                style="--reveal-delay: 120ms"
              >
                your care journey.
              </h2>
            </div>

            <div class="mt-12 grid gap-6 md:grid-cols-3">
              {steps.map((step, i) => (
                <div
                  class="rounded-lg border border-sage/20 bg-white p-7 shadow-sm sm:p-8"
                  data-reveal
                  style={`--reveal-delay: ${i * 100}ms`}
                >
                  <span class="font-serif-italic text-4xl font-light italic text-sage">
                    0{i + 1}
                  </span>
                  <h3 class="mt-3 font-display text-2xl italic leading-tight text-ink">{step.title}</h3>
                  <p class="mt-3 text-base leading-relaxed text-ink/70">{step.description}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>
    )}

    {/* Why 816 */}
    <WhyChoose816 class={bgOf("why")} />

    {/* FAQ */}
    {treatment.faqs.length > 0 && (
      <section class={`${bgOf("faq")} py-20 lg:py-28`}>
        <div class="container mx-auto px-4 sm:px-6 lg:px-8">
          <div class="mx-auto max-w-4xl">
            <p
              class="mb-4 font-sans-wide text-[11px] font-medium tracking-[0.32em] uppercase text-gold"
              data-reveal
            >
              Frequently Asked Questions
            </p>
            <h2
              class="font-display text-4xl italic leading-tight text-ink sm:text-5xl"
              data-reveal
              style="--reveal-delay: 120ms"
            >
              good to know.
            </h2>

            <dl class="mt-10 divide-y divide-sage/15 border-t border-sage/15">
              {treatment.faqs.map((faq, i) => (
                <div class="py-6" data-reveal style={`--reveal-delay: ${i * 80}ms`}>
                  <dt class="font-display text-xl italic leading-snug text-ink sm:text-2xl">{faq.q}</dt>
                  <dd class="mt-3 text-base leading-relaxed text-ink/70">{faq.a}</dd>
                </div>
              ))}
            </dl>
          </div>
        </div>
      </section>
    )}

    {/* Related */}
    {related.length > 0 && (
      <section class={`${bgOf("related")} py-20 lg:py-28`}>
        <div class="container mx-auto px-4 sm:px-6 lg:px-8">
          <div class="mx-auto max-w-6xl">
            <p
              class="mb-4 font-sans-wide text-[11px] font-medium tracking-[0.32em] uppercase text-gold"
              data-reveal
            >
              More Treatments {treatment.group}
            </p>
            <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
              {related.map((item, i) => (
                <a
                  href={`/treatments/${item.slug}`}
                  class="group relative block aspect-[4/5] overflow-hidden rounded-lg shadow-sm transition hover:shadow-md"
                  data-reveal
                  style={`--reveal-delay: ${i * 80}ms`}
                >
                  <img
                    src={item.image}
                    alt={item.name}
                    class="absolute inset-0 size-full object-cover transition duration-500 group-hover:scale-105"
                    loading="lazy"
                    decoding="async"
                  />
                  <div
                    class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/75 via-black/20 to-transparent"
                    aria-hidden="true"
                  ></div>
                  <h3 class="absolute inset-x-0 bottom-0 p-5 font-display text-xl text-white not-italic md:text-2xl">
                    {item.name}
                  </h3>
                </a>
              ))}
            </div>
          </div>
        </div>
      </section>
    )}

    <section class="bg-sage py-20 text-white lg:py-28">
      <div class="container mx-auto px-4 text-center sm:px-6 lg:px-8">
        <p
          class="mb-4 font-sans-wide text-[12px] font-medium tracking-[0.4em] uppercase text-white/80"
          data-reveal
        >
          Schedule Your Consultation Today
        </p>
        <h2
          class="mx-auto max-w-3xl font-display text-4xl italic leading-tight sm:text-5xl lg:text-6xl"
          data-reveal
          style="--reveal-delay: 120ms"
        >
          let's build a plan around your goals.
        </h2>
        <div class="mt-10" data-reveal style="--reveal-delay: 220ms">
          <a
            href={janeAppUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block rounded-full bg-white px-10 py-4 text-center text-lg font-medium text-sage transition hover:bg-white/90"
          >
            Book Appointment
          </a>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
  <QuizTab />
</BaseLayout>
