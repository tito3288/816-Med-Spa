---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import QuizTab from "../../components/QuizTab.astro";
import { serviceMenu, getService } from "../../data/services";
import { treatmentsByGroup } from "../../data/treatments";

const janeAppUrl = "https://816medspa.janeapp.com/";
const ageOptions = treatmentsByGroup("By Age");

const categoryDetails = {
  Face: {
    description: "Injectables, sculpting, and laser treatments designed around your features.",
    representativeSlug: "lip-filler",
  },
  Body: {
    description: "Advanced options for contouring, smoothing, and renewed body confidence.",
    representativeSlug: "evolve",
  },
  Skin: {
    description: "Facials, peels, and resurfacing selected for your unique skin and goals.",
    representativeSlug: "signature-facial",
  },
  Wellness: {
    description: "Personalized medical support for weight, hormones, and whole-person wellness.",
    representativeSlug: "weight-loss-women",
  },
} as const;

const treatmentCategories = serviceMenu.map((column) => {
  const uniqueSlugs = [...new Set(column.groups.flatMap((group) => group.services))];
  const details = categoryDetails[column.category];
  const representative = getService(details.representativeSlug);

  return {
    name: column.category,
    slug: column.category.toLowerCase(),
    description: details.description,
    image: representative?.image ?? getService(uniqueSlugs[0])?.image ?? "",
    treatmentCount: uniqueSlugs.length,
  };
});
---

<BaseLayout
  title="Treatments | 816 Med Spa"
  description="Explore face, body, skin, and wellness treatments at 816 Med Spa in Kansas City, with personalized options for every stage and goal."
  canonical="https://816medspa.com/treatments/"
>
  <SiteHeader />
  <main>
    <section class="relative isolate overflow-hidden bg-espresso text-parchment">
      <div class="container mx-auto px-4 pt-[180px] pb-20 text-center sm:px-6 lg:px-8 lg:pt-[230px] lg:pb-24">
        <p
          class="mb-7 font-sans-wide text-[11px] font-normal tracking-[0.4em] uppercase text-parchment/80"
          data-reveal
        >
          Treatments
        </p>
        <h1
          class="mx-auto max-w-5xl font-serif-italic text-[clamp(52px,8vw,108px)] font-light italic leading-none text-parchment"
          data-reveal
          style="--reveal-delay: 120ms"
        >
          care, organized around you.
        </h1>
        <p
          class="mx-auto mt-8 max-w-2xl text-base leading-relaxed text-parchment/85 sm:text-lg"
          data-reveal
          style="--reveal-delay: 220ms"
        >
          Begin with the kind of care you're looking for. Explore our face, body, skin, and wellness
          treatments, then discover the options that fit your goals.
        </p>
      </div>
    </section>

    <section class="bg-bone py-20 lg:py-28">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-6xl">
          <div class="mb-12 max-w-3xl">
            <p
              class="mb-4 font-sans-wide text-[11px] font-medium tracking-[0.32em] uppercase text-gold"
              data-reveal
            >
              Explore by Category
            </p>
            <h2
              class="font-display text-4xl italic leading-tight text-ink sm:text-5xl lg:text-6xl"
              data-reveal
              style="--reveal-delay: 100ms"
            >
              start with what feels right.
            </h2>
          </div>

          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {treatmentCategories.map((category, i) => (
              <a
                href={`/treatments/${category.slug}`}
                class="group relative block aspect-[3/4] overflow-hidden rounded-2xl shadow-sm transition hover:-translate-y-1 hover:shadow-lg focus-visible:ring-2 focus-visible:ring-sage focus-visible:ring-offset-2 focus-visible:ring-offset-bone"
                data-reveal
                style={`--reveal-delay: ${i * 80}ms`}
              >
                <img
                  src={category.image}
                  alt=""
                  class="absolute inset-0 size-full object-cover transition duration-500 group-hover:scale-105"
                  loading="lazy"
                  decoding="async"
                />
                <div
                  class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/90 via-black/25 to-transparent"
                  aria-hidden="true"
                ></div>
                <div class="relative flex h-full flex-col justify-end p-6">
                  <p class="mb-2 font-sans-wide text-[10px] font-medium tracking-[0.22em] text-white/70 uppercase">
                    {category.treatmentCount} Treatments
                  </p>
                  <h3 class="font-display text-3xl text-white not-italic">{category.name}</h3>
                  <p class="mt-3 text-sm leading-relaxed text-white/85">{category.description}</p>
                  <span class="mt-5 inline-flex items-center gap-2 text-sm font-medium text-white">
                    Explore {category.name}
                    <svg
                      class="size-4 transition-transform group-hover:translate-x-1"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.75"
                      aria-hidden="true"
                    >
                      <path stroke-linecap="round" stroke-linejoin="round" d="m9 18 6-6-6-6"></path>
                    </svg>
                  </span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section id="by-age" class="scroll-mt-24 bg-cream py-20 lg:scroll-mt-32 lg:py-28">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-6xl">
          <div class="mb-12 text-center">
            <p
              class="mb-4 font-sans-wide text-[11px] font-medium tracking-[0.32em] uppercase text-gold"
              data-reveal
            >
              Another Way to Explore
            </p>
            <h2
              class="font-display text-4xl italic leading-tight text-ink sm:text-5xl lg:text-6xl"
              data-reveal
              style="--reveal-delay: 100ms"
            >
              treatments for where you are now.
            </h2>
            <p
              class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-ink/65 sm:text-lg"
              data-reveal
              style="--reveal-delay: 180ms"
            >
              Every season brings different goals. Browse thoughtful recommendations by stage of
              life, or let us help you build a completely personal plan.
            </p>
          </div>

          <div class="flex snap-x snap-mandatory gap-4 overflow-x-auto pb-3 lg:grid lg:grid-cols-5 lg:overflow-visible lg:pb-0">
            {ageOptions.map((option, i) => (
              <a
                href={`/treatments/${option.slug}`}
                class="group relative block aspect-[4/5] w-[min(72vw,250px)] shrink-0 snap-start overflow-hidden rounded-xl shadow-sm transition hover:shadow-md focus-visible:ring-2 focus-visible:ring-sage focus-visible:ring-offset-2 focus-visible:ring-offset-cream lg:w-auto"
                data-reveal
                style={`--reveal-delay: ${i * 70}ms`}
              >
                <img
                  src={option.image}
                  alt=""
                  class="absolute inset-0 size-full object-cover transition duration-500 group-hover:scale-105"
                  loading="lazy"
                  decoding="async"
                />
                <div
                  class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/85 via-black/15 to-transparent"
                  aria-hidden="true"
                ></div>
                <div class="relative flex h-full items-end p-5">
                  <h3 class="font-display text-2xl text-white not-italic">{option.name}</h3>
                </div>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="bg-sage py-20 text-white lg:py-28">
      <div class="container mx-auto px-4 text-center sm:px-6 lg:px-8">
        <p
          class="mb-4 font-sans-wide text-[12px] font-medium tracking-[0.4em] uppercase text-white/80"
          data-reveal
        >
          Not Sure Where to Start?
        </p>
        <h2
          class="mx-auto max-w-3xl font-display text-4xl italic leading-tight sm:text-5xl lg:text-6xl"
          data-reveal
          style="--reveal-delay: 120ms"
        >
          a consultation is the perfect first step.
        </h2>
        <a
          href={janeAppUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-10 inline-block rounded-full bg-white px-10 py-4 text-center text-lg font-medium text-sage transition hover:bg-white/90"
          data-reveal
          style="--reveal-delay: 220ms"
        >
          Book Appointment
        </a>
      </div>
    </section>
  </main>
  <SiteFooter />
  <QuizTab />
</BaseLayout>
