---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import QuizTab from "../components/QuizTab.astro";
import {
  membershipDetails,
  membershipFaqs,
  membershipPlans,
} from "../data/memberships";

const phoneDigits = "8165512322";
const phoneDisplay = "816-551-2322";
const mapsHref =
  "https://www.google.com/maps/dir/?api=1&destination=638+W+39th+St,+Kansas+City,+MO+64111";
---

<BaseLayout
  title="Med Spa Memberships | 816 Aesthetic Med Spa"
  description="Explore Elevate, Refine, and Transform memberships at 816 Aesthetic Med Spa, with monthly account credit, exclusive member pricing, and thoughtful treatment perks."
  canonical="https://816medspa.com/memberships/"
  ogImage="https://816medspa.com/images/aesthetician-room.jpeg"
>
  <SiteHeader />
  <main>
    <section class="memberships-hero relative isolate min-h-[78vh] overflow-hidden text-parchment">
      <div class="absolute inset-0 bg-gradient-to-r from-espresso/90 via-espresso/65 to-espresso/35" aria-hidden="true"></div>
      <div
        class="container relative z-10 mx-auto flex min-h-[78vh] items-center px-4 pt-[190px] pb-20 sm:px-6 lg:px-8 lg:pt-[230px]"
      >
        <div class="max-w-3xl">
          <p
            class="mb-6 font-sans-wide text-[11px] font-medium tracking-[0.4em] text-parchment/80 uppercase"
            data-reveal
          >
            816 Memberships
          </p>
          <h1
            class="font-serif-italic text-[clamp(54px,8vw,108px)] font-light italic leading-[0.92] text-parchment"
            data-reveal
            style="--reveal-delay: 100ms"
          >
            make more room for the care you love.
          </h1>
          <p
            class="mt-8 max-w-2xl text-base leading-relaxed text-parchment/90 sm:text-lg"
            data-reveal
            style="--reveal-delay: 200ms"
          >
            Build your monthly balance while enjoying exclusive member pricing and thoughtful
            treatment perks designed to support your goals all year long.
          </p>
          <a
            href="#membership-levels"
            class="mt-9 inline-flex items-center gap-2 rounded-full border border-parchment/70 px-8 py-4 font-sans-wide text-[11px] font-medium tracking-[0.28em] text-parchment uppercase transition hover:bg-parchment hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-parchment"
            data-reveal
            style="--reveal-delay: 280ms"
          >
            Explore Memberships
            <span aria-hidden="true">↓</span>
          </a>
        </div>
      </div>
    </section>

    <section class="bg-cream py-20 lg:py-28">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:gap-20">
          <div>
            <p
              class="mb-4 font-sans-wide text-[11px] font-medium tracking-[0.32em] text-gold uppercase"
              data-reveal
            >
              Cash &amp; Stash
            </p>
            <h2
              class="font-display text-5xl italic leading-[1.03] text-ink sm:text-6xl lg:text-7xl"
              data-reveal
              style="--reveal-delay: 100ms"
            >
              your monthly care, thoughtfully set aside.
            </h2>
          </div>
          <div data-reveal style="--reveal-delay: 180ms">
            <p class="text-base leading-relaxed text-ink/70 sm:text-lg">
              Each monthly contribution builds in your patient account like an aesthetic savings
              account. Use that balance toward any service at 816 Aesthetic Med Spa, then enjoy
              additional pricing and perks selected for your membership level.
            </p>
            <div class="mt-8 grid grid-cols-3 gap-3">
              {membershipPlans.map((plan) => (
                <a
                  href={`#${plan.slug}`}
                  class="rounded-lg border border-sage/20 bg-bone px-3 py-5 text-center transition hover:-translate-y-0.5 hover:border-sage/45 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sage"
                >
                  <span class="block font-display text-2xl italic text-ink sm:text-3xl">
                    ${plan.monthlyPrice}
                  </span>
                  <span class="mt-1 block font-sans-wide text-[9px] font-medium tracking-[0.18em] text-ink/55 uppercase">
                    Per Month
                  </span>
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="membership-levels" class="scroll-mt-24 bg-bone py-20 lg:scroll-mt-32 lg:py-28">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-6xl">
          <div class="mx-auto mb-14 max-w-3xl text-center">
            <p
              class="mb-4 font-sans-wide text-[11px] font-medium tracking-[0.32em] text-gold uppercase"
              data-reveal
            >
              Membership Levels
            </p>
            <h2
              class="font-display text-5xl italic leading-tight text-ink sm:text-6xl"
              data-reveal
              style="--reveal-delay: 100ms"
            >
              choose the rhythm that fits you.
            </h2>
            <p
              class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-ink/65 sm:text-lg"
              data-reveal
              style="--reveal-delay: 180ms"
            >
              Every level builds monthly account credit and includes member-only pricing, with more
              benefits added at each level.
            </p>
          </div>

          <div class="grid items-stretch gap-6 lg:grid-cols-3">
            {membershipPlans.map((plan, planIndex) => (
              <article
                id={plan.slug}
                class="scroll-mt-28 rounded-2xl border border-sage/20 bg-white p-7 shadow-sm sm:p-8"
                data-reveal
                style={`--reveal-delay: ${planIndex * 90}ms`}
              >
                <div class="border-b border-sage/15 pb-6">
                  <p class="font-sans-wide text-[10px] font-medium tracking-[0.28em] text-gold uppercase">
                    816 Membership
                  </p>
                  <h3 class="mt-3 font-display text-5xl italic leading-none text-ink">{plan.name}</h3>
                  <div class="mt-5 flex items-end gap-2 text-ink">
                    <span class="font-display text-5xl font-medium leading-none not-italic">
                      ${plan.monthlyPrice}
                    </span>
                    <span class="pb-1 text-sm text-ink/55">per month</span>
                  </div>
                </div>

                <ul class="mt-7 space-y-4">
                  {plan.benefits.map((benefit) => (
                    <li class="flex gap-3 text-sm leading-relaxed text-ink/72">
                      <svg
                        class="mt-0.5 size-5 shrink-0 text-sage"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        aria-hidden="true"
                      >
                        <circle cx="12" cy="12" r="9"></circle>
                        <path stroke-linecap="round" stroke-linejoin="round" d="m8.5 12 2.2 2.2 4.8-5"></path>
                      </svg>
                      <span>{benefit}</span>
                    </li>
                  ))}
                </ul>

                {plan.choice && (
                  <div class="mt-8 rounded-xl border border-gold/20 bg-bone/70 p-5">
                    <p class="font-sans-wide text-[10px] font-semibold tracking-[0.22em] text-gold uppercase">
                      {plan.choice.heading}
                    </p>
                    <ul class="mt-4 space-y-3 text-sm leading-relaxed text-ink/70">
                      {plan.choice.options.map((option) => (
                        <li class="flex gap-3">
                          <span class="mt-2 size-1.5 shrink-0 rounded-full bg-gold" aria-hidden="true"></span>
                          <span>{option}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="bg-espresso py-20 text-parchment lg:py-28">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-6xl">
          <div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
            <div>
              <p
                class="mb-4 font-sans-wide text-[11px] font-medium tracking-[0.32em] text-parchment/60 uppercase"
                data-reveal
              >
                Membership Details
              </p>
              <h2
                class="font-display text-5xl italic leading-tight text-parchment sm:text-6xl"
                data-reveal
                style="--reveal-delay: 100ms"
              >
                clear from the very beginning.
              </h2>
              <p
                class="mt-6 max-w-lg text-base leading-relaxed text-parchment/70"
                data-reveal
                style="--reveal-delay: 180ms"
              >
                These terms apply to Elevate, Refine, and Transform memberships.
              </p>
            </div>
            <ol class="grid gap-4 sm:grid-cols-2">
              {membershipDetails.map((detail, detailIndex) => (
                <li
                  class="rounded-xl border border-parchment/15 bg-white/5 p-5"
                  data-reveal
                  style={`--reveal-delay: ${Math.min(detailIndex, 5) * 70}ms`}
                >
                  <span class="font-serif-italic text-2xl font-light italic text-parchment/45">
                    0{detailIndex + 1}
                  </span>
                  <p class="mt-2 text-sm leading-relaxed text-parchment/80">{detail}</p>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-cream py-20 lg:py-28">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-4xl">
          <div class="text-center">
            <p
              class="mb-4 font-sans-wide text-[11px] font-medium tracking-[0.32em] text-gold uppercase"
              data-reveal
            >
              Frequently Asked Questions
            </p>
            <h2
              class="font-display text-5xl italic leading-tight text-ink sm:text-6xl"
              data-reveal
              style="--reveal-delay: 100ms"
            >
              everything you need to know.
            </h2>
          </div>

          <div class="mt-12 border-t border-sage/25">
            {membershipFaqs.map((faq, faqIndex) => (
              <details
                class="membership-faq border-b border-sage/25"
                data-reveal
                style={`--reveal-delay: ${Math.min(faqIndex, 6) * 55}ms`}
              >
                <summary
                  class="flex cursor-pointer list-none items-center justify-between gap-6 py-6 font-display text-xl italic leading-snug text-ink transition hover:text-sage focus-visible:rounded-md focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sage sm:text-2xl"
                >
                  <span>{faq.question}</span>
                  <span
                    class="relative grid size-9 shrink-0 place-items-center rounded-full border border-sage/35"
                    aria-hidden="true"
                  >
                    <span class="absolute h-px w-3.5 bg-current"></span>
                    <span class="faq-vertical absolute h-3.5 w-px bg-current transition duration-200"></span>
                  </span>
                </summary>
                <div class="max-w-3xl space-y-3 pb-7 pr-12 text-base leading-relaxed text-ink/70">
                  {faq.answer.map((paragraph) => <p>{paragraph}</p>)}
                </div>
              </details>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="bg-sage py-20 text-white lg:py-28">
      <div class="container mx-auto px-4 text-center sm:px-6 lg:px-8">
        <p
          class="mb-4 font-sans-wide text-[12px] font-medium tracking-[0.4em] text-white/80 uppercase"
          data-reveal
        >
          Ready to Join?
        </p>
        <h2
          class="mx-auto max-w-3xl font-display text-5xl italic leading-tight sm:text-6xl"
          data-reveal
          style="--reveal-delay: 100ms"
        >
          make your care part of the plan.
        </h2>
        <p
          class="mx-auto mt-6 max-w-2xl text-base leading-relaxed text-white/90 sm:text-lg"
          data-reveal
          style="--reveal-delay: 180ms"
        >
          Call us or stop by our West 39th Street location. Our team will help you choose your
          membership and complete enrollment.
        </p>
        <div
          class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row"
          data-reveal
          style="--reveal-delay: 260ms"
        >
          <a
            href={`tel:${phoneDigits}`}
            class="rounded-full bg-white px-9 py-4 text-center text-base font-medium text-sage transition hover:bg-white/90 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
          >
            Call to Join · {phoneDisplay}
          </a>
          <a
            href={mapsHref}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-full border-2 border-white px-9 py-4 text-center text-base font-medium text-white transition hover:bg-white hover:text-sage focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
          >
            Visit Us
          </a>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
  <QuizTab />
</BaseLayout>

<style>
  .memberships-hero {
    background-color: var(--color-espresso);
    background-image: url("/images/aesthetician-room.jpeg");
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
  }

  .membership-faq summary::-webkit-details-marker {
    display: none;
  }

  .membership-faq[open] .faq-vertical {
    opacity: 0;
    transform: rotate(90deg);
  }

  @media (max-width: 640px) {
    .memberships-hero {
      background-position: 62% center;
    }
  }
</style>
